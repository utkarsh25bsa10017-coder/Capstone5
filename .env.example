# Database
DATABASE_URL="postgresql://user:password@localhost:5432/changelogai?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production-min-32-chars"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id-here"
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"

# GitHub OAuth (optional - for repo access)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Anthropic (for AI features - optional)
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# Encryption key for sensitive data (generate with: openssl rand -hex 32)
ENCRYPTION_KEY="your-32-char-encryption-key-here"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ChangelogAI"